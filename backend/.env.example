PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173
DEFAULT_PASS_PERCENTAGE=70
SUPABASE_STORAGE_BUCKET=course-materials

# Required: provider API keys
# Set at least one of these — the AI provider is hardcoded in src/config/env.ts
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Role allow-lists. Comma-separated emails.
# ADMIN_EMAILS: addresses that may claim the Admin role (server-side check).
# LECTURER_OVERRIDE_EMAILS: addresses that may claim the Lecturer role
#   even when signing in with a non-UTM account (e.g. developer Gmail).
ADMIN_EMAILS=
LECTURER_OVERRIDE_EMAILS=
