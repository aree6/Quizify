PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173
DEFAULT_PASS_PERCENTAGE=70
SUPABASE_STORAGE_BUCKET=course-materials

# AI Provider: openai | gemini | deepseek
# If AI_PROVIDER is unset, auto-detected in priority: deepseek -> openai -> gemini -> none
AI_PROVIDER=deepseek

# OpenAI config
OPENAI_API_KEY=

# Gemini config (used for embeddings when provider is gemini or deepseek)
GEMINI_API_KEY=

# DeepSeek config (generation)
DEEPSEEK_API_KEY=

# Embeddings (keep gemini-embedding-001 since DeepSeek has no embedding endpoint)
EMBEDDING_MODEL=gemini-embedding-001

# Generation
GENERATION_MODEL=deepseek-v4-flash

# DeepSeek thinking/reasoning
# For reasoning tasks: THINKING_ENABLED=true, REASONING_EFFORT=high
# For JSON generation: THINKING_ENABLED=false (recommended)
THINKING_ENABLED=true
REASONING_EFFORT=low

# Max output tokens (DeepSeek supports up to 384K)
MAX_OUTPUT_LESSON=64000
MAX_OUTPUT_QUIZ=32000
MAX_OUTPUT_OUTLINE=16000
