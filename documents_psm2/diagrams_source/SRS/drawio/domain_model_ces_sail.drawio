  <diagram id="domain-quizify" name="Domain Model - QUIZIFY (Supabase)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="materials" value="materials&#xa;&#xa;id, course_code,&#xa;material_type (slide | course_info),&#xa;chapter, file_name,&#xa;storage_path, status&#xa;(Processing | Active | Failed | Deleted)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="240" height="180" as="geometry"/>
