        <mxCell id="questions" value="questions&#xa;&#xa;id, quiz_id, prompt,&#xa;option_a, option_b,&#xa;option_c, option_d,&#xa;correct_option_index,&#xa;explanations (jsonb),&#xa;metadata (jsonb: topic, bloom, solo)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
