sequenceDiagram
  autonumber

  actor L as Lecturer
  participant UI as Web UI
  participant Course as Course API
  participant RAG as RAG Service
  participant DB as Database

  L->>UI: Continue generation
  activate UI
  UI->>Course: Generate lesson
  activate Course

  Course->>RAG: Generate lesson from extracted context
  activate RAG
  RAG-->>Course: Lesson content
  deactivate RAG

  alt [lesson generated]
    Course->>DB: Save Lesson
    activate DB
    DB-->>Course: Lesson saved
    deactivate DB

    Course-->>UI: Lesson ready
  else [generation failed]
    Course-->>UI: 502 Generation error
  end

  deactivate Course
  deactivate UI
