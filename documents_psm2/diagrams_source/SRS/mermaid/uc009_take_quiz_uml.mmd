sequenceDiagram
  autonumber
  actor S as Student
  participant UI as Public Web Page
  participant Sub as Submission API
  participant DB as Database

  S->>UI: Enter name
  S->>UI: Select answers
  S->>UI: Click Submit
  activate UI

  UI->>Sub: POST /public/submissions (name, answers)
  activate Sub
  Sub->>Sub: Validate name + answers

  alt [name invalid]
    Sub-->>UI: 400 Bad Request
    UI-->>S: Show validation message
  else [name valid]
    alt [missing answers]
      Sub-->>UI: 422 Unprocessable Entity
      UI-->>S: Prompt to complete unanswered questions
    else [all answers provided]
      Sub->>Sub: Calculate score
      Sub->>DB: Save submission + answers
      activate DB
      DB-->>Sub: Saved / error
      deactivate DB

      alt [stored successfully]
        Sub-->>UI: Score + confirmation
        UI-->>S: Display score
      else [storage failure]
        Sub-->>UI: 500 Error
        UI-->>S: Show submission error + allow retry
      end
    end
  end

  deactivate Sub

  deactivate UI
